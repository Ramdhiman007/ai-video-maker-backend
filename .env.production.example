# ═══════════════════════════════════════════════════════
#  AI Video Maker Agent — PRODUCTION Environment Config
#  Copy this to .env and fill in your actual values.
#  NEVER commit the real .env file to Git!
# ═══════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=False

# ── Google Gemini AI (optional — falls back to algorithmic planner if empty) ─
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of your Hostinger website domains.
ALLOWED_ORIGINS=https://www.ramtechnicalhelp.com,https://ramtechnicalhelp.com

# ── Upstash Redis (free tier at upstash.com) ─────────────
# Get from: https://console.upstash.com → Create Database → Redis URL
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_UPSTASH_HOST.upstash.io:6379

# ── Cloudflare R2 (free 10GB/mo at cloudflare.com/r2) ───
# Get from: Cloudflare Dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ai-video-maker
# Public R2 URL — enable in Cloudflare R2 bucket settings
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev

# ── FFmpeg (pre-installed in Docker image) ────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Storage Directories (local / worker temp) ────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMP_DIR=temp

# ── Upload Limits ─────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500

# ── Auto-Cleanup ──────────────────────────────────────────
VIDEO_EXPIRY_HOURS=24

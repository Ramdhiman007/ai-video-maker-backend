# ─── Server & Environment ─────────────────────────────────────────
HOST="0.0.0.0"
PORT="8000"
ENVIRONMENT="production"
DEBUG="False"
ALLOWED_ORIGINS="https://www.ramtechnicalhelp.com,https://ramtechnicalhelp.com,http://localhost:8080"

# ─── Media & FFmpeg Paths ─────────────────────────────────────────
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
MAX_UPLOAD_SIZE_MB="500"
VIDEO_EXPIRY_HOURS="2"

# ─── AI Video Generation & Screenplay Keys ───────────────────────
# Primary key for Google Veo 2.0, Imagen 3, and Screenplay Director
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional Alternative Real AI Video Providers (Configure any you use):
LUMA_API_KEY=""
RUNWAY_API_KEY=""
KLING_API_KEY=""
REPLICATE_API_KEY=""

# Preferred provider: auto, veo, luma, runway, kling, replicate
VIDEO_PROVIDER="auto"

# ─── Storage (Optional: Cloudflare R2 for persistent CDN delivery) ─
# Leave blank to serve videos directly from Railway / local disk
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ai-video-maker"
R2_PUBLIC_URL=""

# ─── Redis (Optional: Task caching) ───────────────────────────────
# Leave blank to use built-in fast persistent SQLite storage
REDIS_URL=""
